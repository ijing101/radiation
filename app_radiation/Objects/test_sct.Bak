; *************************************************************
; *** Scatter-Loading Description File generated by uVision ***
; *** APP 链接基址 0x08005000，与 Bootloader 的 APP_SECTOR_ADDR 一致 ***
; *************************************************************

LR_IROM1 0x08005000 0x0000A800  {    ; APP 区域 42KB（0x08005000 ~ 0x0800F7FF）
  ER_IROM1 0x08005000 0x0000A800  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00002000  {  ; RW data（8KB SRAM）
   .ANY (+RW +ZI)
  }
}
